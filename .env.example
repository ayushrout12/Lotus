# Firebase web app configuration (safe to expose to the browser; protect data with Firebase rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only AI key. Configure this in the deployment provider; never prefix it with VITE_.
GEMINI_API_KEY=

# Optional server-side services
E2B_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NETLIFY_ACCESS_TOKEN=
